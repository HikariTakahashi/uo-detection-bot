[Unit]
Description=Laya shadow inference (loopback only)
After=network.target

# User unit: install to ~/.config/systemd/user/ on the Raspberry Pi.
# Reuses the already installed, pinned offline Laya sandbox.
[Service]
Type=simple
WorkingDirectory=%h/laya-sandbox
ExecStart=/usr/bin/flock -n %h/laya-sandbox/run.lock %h/laya-sandbox/.venv/bin/python %h/laya-sandbox/serve_shadow.py
Restart=on-failure
RestartSec=15
CPUQuota=100%
Nice=10
LimitAS=4294967296
LimitCORE=0
TasksMax=32
NoNewPrivileges=true
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1 TOKENIZERS_PARALLELISM=false
Environment=HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_IMPLICIT_TOKEN=1
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=2 USE_TF=0

[Install]
WantedBy=default.target
