[Unit]
Description=Generate decoders from approved public synthetic templates
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/laya-decoder/luna-key
[Service]
Type=oneshot
User=laya-decoder
Group=laya-decoder
SupplementaryGroups=docker
WorkingDirectory=/opt/laya-decoder/current
StateDirectory=laya-decoder
StateDirectoryMode=0700
LoadCredential=luna-key:/etc/laya-decoder/luna-key
ExecStart=/usr/bin/python3 services/decoder/generate.py --state /var/lib/laya-decoder --templates /etc/laya-decoder/public-templates --image sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
TimeoutStartSec=300
CPUQuota=100%
Nice=10
LimitCORE=0
