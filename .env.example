# Store real values only in /etc/discord-bot.env on the Raspberry Pi.
DISCORD_TOKEN=
# Optional. Empty registers /ping globally. Otherwise use a server the Bot has joined.
DISCORD_GUILD_ID=
# Optional detection paths. Config changes take effect after restarting the bot.
DETECTION_CONFIG_PATH=/etc/discord-bot/config.json
DETECTION_STATE_PATH=/var/lib/discord-bot/counts.json
# Optional shadow collection and private review storage (independent of counts).
SHADOW_CONFIG_PATH=/etc/discord-bot/shadow.json
SHADOW_DATA_PATH=/var/lib/discord-bot/shadow
# Optional scheduled notifications. Set both Discord IDs to enable them.
DISCORD_CHANNEL_ID=
DISCORD_USER_ID=
# Optional. Defaults to the channel from pi-discord-server.
YOUTUBE_CHANNEL_ID=
